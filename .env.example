# C-MAKER 환경변수 템플릿 (docs/10-implementation-guide.md §3.3)
# 이 파일을 저장소 루트의 .env로 복사해 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 인증키·비밀번호를 이 파일(템플릿)에 적지 않는다.

# ─── 실행 환경 ───
# dev: API 문서(/api/docs) 노출, JWT_SECRET 미설정 시 임시 키 사용, 개발용 픽스처 적재 허용
APP_ENV=prod

# ─── DB (기존 myapp_db / myapp_user 사용) ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_db
DB_USER=
DB_PASSWORD=
# 공유 DB의 기존 테이블과 이름이 겹치지 않도록 C-MAKER 전용 스키마를 쓴다(schema.sql이 생성)
DB_SCHEMA=cmaker

# ─── JWT ───
# 32자 이상 무작위 문자열. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── 공공데이터포털 (data.go.kr) — 승인 8건 공통 ───
DATA_GO_KR_SERVICE_KEY=
# ─── 별도 포털 (아직 미발급이면 빈칸으로 두세요) ───
# ECOS_API_KEY: 한국은행 경제통계시스템(ECOS) 인증키
ECOS_API_KEY=
# OPINET_API_KEY: 오피넷 유가정보 인증키
OPINET_API_KEY=
# VWORLD_API_KEY: 공간정보 오픈플랫폼 지오코더 인증키(지점 주소 → 좌표, RULE-BRANCH-03)
VWORLD_API_KEY=
# 지방행정 인허가 전수 파일(CSV)을 내려받아 두는 디렉터리 (월간 모집단 적재, 비우면 건너뜀)
PERMIT_FULL_DATA_DIR=

# ─── LLM (LiteLLM Gateway, OpenAI-Compatible) ───
# 비워두면 브리프 화법은 정형 인사 문구(TEMPLATE)로 대체된다
# LLM_BASE_URL: /v1 까지 포함한다 (예: https://frontier-llmgw.aipocnhbank.com/v1)
LLM_BASE_URL=
# LLM_API_KEY: LiteLLM Virtual Key (sk-...). Authorization: Bearer 헤더로 전송된다
LLM_API_KEY=
# 게이트웨이 제공 모델: claude-opus-5, claude-sonnet-5, claude-opus-4-8, claude-haiku-4-5-20251001-v1:0
LLM_MODEL=claude-opus-5
# 실측(claude-opus-5, thinking 비활성): 약 30토큰/초. 400토큰 상한 기준 약 14초
LLM_TIMEOUT_SECONDS=15
# opus/sonnet 5 계열은 extended thinking이 기본 ON이고, thinking 토큰이 max_tokens를 소진해
# 본문이 빈 응답으로 돌아온다. 브리프는 문장화 작업이므로 비활성(true)이 기본이다.
LLM_DISABLE_THINKING=true

# ─── 배치 ───
# 수동 재실행 쿨다운(분, VAL-12)
BATCH_COOLDOWN_MINUTES=30
# 구조화 로그 파일 디렉터리(예: /var/log/c-maker). 비우면 stdout으로만 출력
LOG_DIR=

# ─── 서버 ───
# CORS 허용 origin(쉼표 구분). 와일드카드(*) 금지(OPS-07)
FRONTEND_ORIGIN=http://localhost
